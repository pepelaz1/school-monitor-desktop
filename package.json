{
  "name": "school-monitor-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Offline school questionnaire monitoring for one employee, with descriptive reports",
  "type": "module",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.mjs",
    "package:mac": "electron-packager . 'Школьный мониторинг' --app-bundle-id=dev.pepelaz.schoolmonitor --platform=darwin --arch=arm64 --out=dist --overwrite --ignore='^/(dist|test|docs|.git)'",
    "package:win": "electron-packager . SchoolMonitor --platform=win32 --arch=x64 --out=dist --overwrite --ignore='^/(dist|test|docs|.git)'"
  },
  "dependencies": {
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0",
    "prettier": "3.9.10"
  }
}
